# Per-machine secrets — install copies this to ~/.secrets; fill it in
# export SOME_API_KEY=""
# export WORK_TOKEN=""

# GitHub token for the patchark/casks private Homebrew tap (classic PAT, repo scope).
# Required to tap patchark/casks and install/upgrade the patched apps in the work
# and personal Brewfiles.
# export HOMEBREW_GITHUB_API_TOKEN=""
